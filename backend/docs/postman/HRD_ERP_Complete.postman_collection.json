{
  "info": {
    "name": "HRD ERP - Technical Test Complete Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mengikuti TECHNICAL TEST HRD WEB BASED ERP-1.pdf. Jalankan manual per role, bukan semua folder sekaligus. Auth memakai cookie+CSRF; admin membutuhkan MFA sesuai kebijakan. Semua mutation ERP dilewati kecuali runErpWrites=true. Pilih salah satu submit/cancel/approve/reject sesuai workflow. PeriodYear/body akan diterima sebagai angka dari coercion backend. Seed demo kredensial ada di backend/.demo-accounts.json (lokal, jangan diunggah)."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 - Ambil CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "csrf"
              ]
            },
            "description": "Jalankan dahulu. Menetapkan cookie anonymous bila belum ada session. Token CSRF tersimpan otomatis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"csrfToken\", pm.response.json().data.csrfToken);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Contoh response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/csrf",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "csrf"
                  ]
                },
                "description": "Jalankan dahulu. Menetapkan cookie anonymous bila belum ada session. Token CSRF tersimpan otomatis."
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"csrfToken\": \"<csrf-token>\"\n  }\n}"
            }
          ]
        },
        {
          "name": "02 - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Isi loginEmail/loginPassword pada environment. Cookie dan CSRF baru menggantikan session sebelumnya. Token CSRF disimpan otomatis. Bila MFA aktif, isi loginOtp dari authenticator (kode hanya sekali pakai) atau loginRecoveryCode. Script menghapus field faktor yang kosong.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\",\n  \"otp\": \"{{loginOtp}}\",\n  \"recoveryCode\": \"{{loginRecoveryCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "if (!body.otp) delete body.otp;",
                  "if (!body.recoveryCode) delete body.recoveryCode;",
                  "pm.request.body.update(JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"csrfToken\", pm.response.json().data.csrfToken);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Contoh response",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-CSRF-Token",
                    "value": "{{csrfToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ]
                },
                "description": "Isi loginEmail/loginPassword pada environment. Cookie dan CSRF baru menggantikan session sebelumnya. Token CSRF disimpan otomatis.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"user\": {\n      \"id\": \"11111111-1111-4111-8111-111111111111\",\n      \"email\": \"admin@example.com\",\n      \"role\": \"HRD/Admin\",\n      \"is_active\": true\n    },\n    \"csrfToken\": \"<new-csrf-token>\"\n  }\n}"
            }
          ]
        },
