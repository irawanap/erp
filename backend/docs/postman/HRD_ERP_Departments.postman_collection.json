        },
        {
          "name": "Session aktif",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "sessions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const session = pm.response.json().data.find(s => !s.is_current);",
                  "  if (session) pm.environment.set(\"sessionId\", session.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
