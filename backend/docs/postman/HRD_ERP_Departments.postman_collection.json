              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"11111111-1111-4111-8111-111111111111\",\n    \"email\": \"admin@example.com\",\n    \"role\": \"HRD/Admin\",\n    \"is_active\": true\n  }\n}"
            }
