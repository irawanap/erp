{
  "name": "backend",
  "version": "1.0.0",
  "description": "Technical Test HRD Web Based ERP",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:create-migration": "node-pg-migrate create --migrations-dir database/migrations --migration-file-language sql",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "test": "jest --runInBand",
    "auth:cleanup": "node scripts/cleanup-auth.js",
    "auth:create-admin": "node scripts/create-admin.js",
    "db:seed:demo": "node scripts/seed-demo.js"
  },
  "author": "Irawan Aji P",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "node-pg-migrate": "^9.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
