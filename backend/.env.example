PORT=3000
CORS_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrd_erp
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Set true only when self-registration as Employee is intended.
ENABLE_PUBLIC_REGISTRATION=false
# Set exact trusted reverse-proxy addresses in production; leave empty locally.
TRUST_PROXY=

# Separate encryption key for authenticator secrets: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Admin MFA is required by default. Only local development may opt out with false.
REQUIRE_ADMIN_MFA=true

# JavaScript weekday numbers: Sunday=0, Monday=1.
WORK_WEEKDAYS=1,2,3,4,5
